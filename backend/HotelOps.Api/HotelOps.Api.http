@HotelOps.Api_HostAddress = http://localhost:5091
# Kopier versjon fra siste GET/vellykkede PATCH for valgt rom før hver endring.
X-Rom-Versjon: {{RomVersjon}}
@RomVersjon = 00000000-0000-0000-0000-000000000000
@RomId = 00000000-0000-0000-0000-000000000000

GET {{HotelOps.Api_HostAddress}}/api/helse
Accept: application/json

###

GET {{HotelOps.Api_HostAddress}}/api/rom
Accept: application/json

###

POST {{HotelOps.Api_HostAddress}}/api/rom
Content-Type: application/json

{
  "nummer": "101",
  "etasje": 1
}

###

PATCH {{HotelOps.Api_HostAddress}}/api/rom/{{RomId}}/rengjoring/marker-skitten
X-Rom-Versjon: {{RomVersjon}}

###

PATCH {{HotelOps.Api_HostAddress}}/api/rom/{{RomId}}/rengjoring/start
X-Rom-Versjon: {{RomVersjon}}

###

PATCH {{HotelOps.Api_HostAddress}}/api/rom/{{RomId}}/rengjoring/fullfor
X-Rom-Versjon: {{RomVersjon}}

###

# Bruk et rom som er skittent eller under rengjøring.
PATCH {{HotelOps.Api_HostAddress}}/api/rom/{{RomId}}/rengjoring/planlegg
X-Rom-Versjon: {{RomVersjon}}
Content-Type: application/json

{
  "ansvarligRenholder": "Kari",
  "prioritet": "Haster"
}

###
